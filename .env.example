# ==============================================================================
# PEDIGOCHOS - VARIABLES DE ENTORNO Y CLAVES MAESTRAS DE SEGURIDAD
# ==============================================================================
# Copia este archivo a ".env" para configurar tus credenciales locales o
# define estas variables directamente en el Dashboard de Render (Environment Variables).

# Puerto del servidor (Render lo asigna automáticamente en producción)
PORT=3000

# ------------------------------------------------------------------------------
# 🔐 CLAVES MAESTRAS (Master Keys de Seguridad)
# ------------------------------------------------------------------------------

# 1. Clave Maestra del Dueño / Superadmin
# Usada para ingresar a /admin.html y /api/owner/login.
# Puedes definir una sola clave o varias separadas por coma.
# Ejemplo: OWNER_MASTER_KEY=MiClaveDueño2026!,0424
OWNER_MASTER_KEY=0424,DUEÑO123

# 2. Código Maestro de Seguridad para Acciones Críticas
# Requerido para eliminar permanentemente comercios o resetear facturación a $0.
# Si no se define, hereda automáticamente el valor de OWNER_MASTER_KEY.
SAFETY_CONFIRM_KEY=0424

# 3. Clave Maestra para Cocinas / Comercios
# Permite a la administración central vincularse o gestionar cualquier cocina en /kitchen.html.
MERCHANT_MASTER_KEY=0424,DUEÑO123

# 4. Clave Maestra de Repartidores / Drivers
# Usada en /driver.html y /api/driver/login para acceso maestro de supervisión de flota.
DRIVER_MASTER_KEY=12345@,GOCHO-8821

# 5. Modo Estricto de Seguridad (true / false)
# - false (por defecto): Mantiene compatibilidad con las claves base (0424, 12345@).
# - true (recomendado en producción): DESACTIVA las claves por defecto y EXIGE que el
#   acceso sea ÚNICAMENTE mediante las claves secretas definidas arriba.
STRICT_SECURITY=false

# ------------------------------------------------------------------------------
# 🗄️ PERSISTENCIA EN LA NUBE (Supabase PostgreSQL & Cloud Storage)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-anon-key-de-supabase
SUPABASE_SERVICE_KEY=tu-service-role-key-opcional

# ------------------------------------------------------------------------------
# 🤖 INTELIGENCIA ARTIFICIAL (Menú Digital Scanner & Parser)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=tu-gemini-api-key-opcional
